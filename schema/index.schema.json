{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AiCode plugin index",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plugins"],
  "properties": {
    "schema_version": { "const": 1 },
    "plugins": {
      "type": "array",
      "maxItems": 5000,
      "items": { "$ref": "#/$defs/plugin" }
    }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$",
      "maxLength": 64
    },
    "httpsUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://",
      "maxLength": 1024
    },
    "languageTag": {
      "type": "string",
      "pattern": "^([Dd][Ee][Ff][Aa][Uu][Ll][Tt]|[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*)$"
    },
    "localizedName": {
      "oneOf": [
        { "type": "string", "minLength": 1, "maxLength": 120 },
        {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 16,
          "propertyNames": { "$ref": "#/$defs/languageTag" },
          "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 120 }
        }
      ]
    },
    "localizedDescription": {
      "oneOf": [
        { "type": "string", "minLength": 1, "maxLength": 2000 },
        {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 16,
          "propertyNames": { "$ref": "#/$defs/languageTag" },
          "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 2000 }
        }
      ]
    },
    "plugin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "description", "author", "repository"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*\\.[a-z][a-z0-9-]*$",
          "maxLength": 96
        },
        "name": { "$ref": "#/$defs/localizedName" },
        "description": { "$ref": "#/$defs/localizedDescription" },
        "author": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "maxLength": 48
        },
        "repository": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/?$",
          "maxLength": 512
        },
        "logo": { "$ref": "#/$defs/httpsUrl" },
        "homepage": { "$ref": "#/$defs/httpsUrl" },
        "license": { "type": "string", "minLength": 1, "maxLength": 128 },
        "tags": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "enum": [
              "provider",
              "tool",
              "skill",
              "agent",
              "mcp",
              "ui",
              "integration",
              "other"
            ]
          }
        },
        "version": { "$ref": "#/$defs/semver" },
        "min_app_version": { "$ref": "#/$defs/semver" }
      }
    }
  }
}
